{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "importHelpers": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "baseUrl": ".",
    "emitDeclarationOnly": false,
    "composite": true,
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "scripthost"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "playground/**/*.ts",
    "playground/**/*.vue",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "dist/index.ts",
    "dist/vue3-draggable-resizable.d.ts",
    "vue3-draggable-resizable.d.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}