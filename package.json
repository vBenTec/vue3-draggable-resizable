{
  "name": "vue3-draggable-resizable",
  "version": "1.6.1",
  "private": false,
  "description": "[Vue3 Component] draggable and resizable component for Vue 3, support snapping and aligning.",
  "scripts": {
    "dev": "vite",
    "serve": "vite preview",
    "lint": "eslint --ext .js,.vue --ignore-path .gitignore --fix src",
    "build": "npm run build:lib && npm run build:dts",
    "build:lib": "vite build --target lib --name Vue3DraggableResizable src/index.html",
    "build:dts": "tsc src/index.html --declaration --declarationDir typings"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/node": "^24.0.4",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-vue": "^10.2.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "vue": "^3.5.17"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a7650/vue3-draggable-resizable.git"
  },
  "bugs": {
    "url": "https://github.com/a7650/vue3-draggable-resizable/issues"
  },
  "homepage": "https://github.com/a7650/vue3-draggable-resizable",
  "keywords": [
    "vue",
    "component",
    "draggable",
    "resizable"
  ],
  "main": "src/index.js",
  "module": "src/index.js",
  "unpkg": "src/index.js",
  "typings": "typings/index.d.ts",
  "packageManager": "pnpm@10.12.3"
}
