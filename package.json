{
  "name": "vue-draggable-resizable",
  "version": "1.6.1",
  "private": false,
  "description": "[Vue3 Component] draggable and resizable component for Vue 3, support snapping and aligning.",
  "scripts": {
    "dev-vue": "vite",
    "serve": "vite preview",
    "lint": "eslint --ext .js,.vue --ignore-path .gitignore --fix src",
    "build": "vite build",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/node": "^24.0.4",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-vue": "^10.2.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "npm:rolldown-vite@latest",
    "vue": "^3.5.17"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vBenTec/vue3-draggable-resizable.git"
  },
  "bugs": {
    "url": "https://github.com/vBenTec/vue3-draggable-resizable/issues"
  },
  "homepage": "https://github.com/vBenTec/vue3-draggable-resizable",
  "keywords": [
    "vue",
    "component",
    "draggable",
    "resizable"
  ],
  "main": "./dist/vue-draggable-resizable.umd.cjs",
  "module": "./dist/vue-draggable-resizable.mjs",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/vue-draggable-resizable.js",
      "require": "./dist/vue-draggable-resizable.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.12.3"
}